{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd client-side && npx prisma generate && npx next build --webpack",
  "outputDirectory": "client-side/.next",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/generate-analytics",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/process-scheduled-shipments",
      "schedule": "0 4 * * *"
    }
  ]
}
