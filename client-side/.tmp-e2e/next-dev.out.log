prisma:query 
      CREATE TABLE IF NOT EXISTS production_capacity (
        id BIGSERIAL PRIMARY KEY,
        business_id INTEGER NOT NULL,
        date DATE NOT NULL,
        max_token INTEGER NOT NULL DEFAULT 600,
