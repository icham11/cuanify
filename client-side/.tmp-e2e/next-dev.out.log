            -- Pastikan status pesanannya aktif (bukan cancelled/completed)
            AND bo.order_status NOT IN (
              $4,
              $5,
              $6,
              $7
            )
            -- Hanya jika pesanan tersebut memang memakan kapasitas token > 0
            AND bo.token_used > 0
