prisma:query 
    SELECT id, metadata
    FROM "BusinessDocument"
    WHERE "businessId" = $1
      AND "sourceType" = $2
      AND content = $3
    ORDER BY "updatedAt" DESC
    LIMIT 1
  
prisma:query 
