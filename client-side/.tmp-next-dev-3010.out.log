    DO $$
    BEGIN
      IF NOT EXISTS (
        SELECT 1
        FROM pg_constraint
        WHERE conname = 'bakery_orders_sales_channel_check'
      ) THEN
        ALTER TABLE bakery_orders
          ADD CONSTRAINT bakery_orders_sales_channel_check
          CHECK (sales_channel IN ('direct', 'tokopedia', 'shopee'));
      END IF;
    EXCEPTION
      WHEN duplicate_object THEN NULL;
    END
    $$;
  
