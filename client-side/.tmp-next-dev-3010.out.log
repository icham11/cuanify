prisma:query 
            WITH active_tokens AS (
              SELECT
                delivery_date::date AS delivery_date,
                GREATEST(0, COALESCE(SUM(token_used), 0))::integer AS used_token
              FROM bakery_orders
              WHERE business_id = $1
                AND delivery_date IS NOT NULL
                AND deleted_at IS NULL
                AND order_status NOT IN ($2, $3, $4, $5)
              GROUP BY delivery_date::date
            )
            INSERT INTO production_capacity (
              business_id,
              date,
              max_token,
              used_token,
              created_at,
              updated_at
            )
            SELECT
              $6,
              active_tokens.delivery_date,
              $7,
              LEAST($8, active_tokens.used_token),
              NOW(),
              NOW()
            FROM active_tokens
            ON CONFLICT (business_id, date)
            DO UPDATE SET
              used_token = LEAST(
                production_capacity.max_token,
                GREATEST(0, EXCLUDED.used_token)
              ),
              updated_at = NOW()
          
prisma:query 
            UPDATE production_capacity pc
            SET used_token = 0,
                updated_at = NOW()
            WHERE pc.business_id = $1
              AND NOT EXISTS (
                SELECT 1
                FROM bakery_orders bo
                WHERE bo.business_id = pc.business_id
                  AND bo.delivery_date IS NOT NULL
                  AND bo.deleted_at IS NULL
                  AND bo.delivery_date::date = pc.date
                  AND bo.order_status NOT IN ($2, $3, $4, $5)
                  AND bo.token_used > 0
              )
          
prisma:query SELECT "public"."BusinessDocument"."id", "public"."BusinessDocument"."content" FROM "public"."BusinessDocument" WHERE ("public"."BusinessDocument"."businessId" = $1 AND "public"."BusinessDocument"."sourceType" = $2) ORDER BY "public"."BusinessDocument"."updatedAt" DESC LIMIT $3 OFFSET $4
prisma:query UPDATE "public"."BusinessDocument" SET "content" = $1, "metadata" = $2, "sourceId" = $3, "chunkIndex" = $4, "updatedAt" = $5 WHERE ("public"."BusinessDocument"."id" = $6 AND 1=1) RETURNING "public"."BusinessDocument"."id", "public"."BusinessDocument"."businessId", "public"."BusinessDocument"."content", "public"."BusinessDocument"."sourceType", "public"."BusinessDocument"."sourceId", "public"."BusinessDocument"."metadata", "public"."BusinessDocument"."chunkIndex", "public"."BusinessDocument"."createdAt", "public"."BusinessDocument"."updatedAt", "public"."BusinessDocument"."contentHash"
