              status_history,
              automation_logs,
              payment_transactions,
              difficulty,
              token_used,
              updated_at
            ) VALUES (
              $1,
              $2::uuid,
              $3,
              $4,
              $5,
              $6,
              $7,
              $8,
              $9,
              $10,
              $11,
