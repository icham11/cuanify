{
  "name": "client-side",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/clean-next-dev-cache.mjs && next dev --webpack",
    "dev:turbo": "node ./scripts/clean-next-dev-cache.mjs && next dev --turbopack",
    "dev:webpack": "node ./scripts/clean-next-dev-cache.mjs && next dev --webpack",
    "build:vercel": "if [ -f prisma/schema.prisma ]; then npx prisma generate --schema prisma/schema.prisma; elif [ -f client-side/prisma/schema.prisma ]; then npx prisma generate --schema client-side/prisma/schema.prisma && cd client-side; else echo 'Prisma schema not found' && exit 1; fi && npx next build --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "docs:wa-parser-pdf": "node ./scripts/export-customer-wa-parser-templates-pdf.mjs",
    "check:ready:sandbox": "node ./scripts/check-prod-readiness.mjs --target=sandbox",
    "check:ready:prod": "node ./scripts/check-prod-readiness.mjs --target=production",
    "fix:schema": "node ./scripts/fix-schema.mjs",
    "seed:mock-sales": "node ./scripts/seed-mock-sales.mjs",
    "seed:biz11-150": "node ./scripts/seed-biz11-150days.mjs",
    "test:email": "node ./scripts/test-email.mjs",
    "xendit:smoke": "node ./scripts/xendit-invoice-smoke.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "arima": "^0.2.8",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.34.0",
    "groq-sdk": "^0.37.0",
    "imagekit": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.570.0",
    "midtrans-client": "^1.4.3",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "pdf-parse": "^1.1.4",
    "pg": "^8.18.0",
    "pgvector": "^0.2.1",
    "puppeteer": "^24.40.0",
    "react": "^19.2.4",
    "react-big-calendar": "^1.19.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.71.1",
    "react-markdown": "^10.1.0",
    "react-tooltip": "^5.30.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tooltip": "^1.6.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.10",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.4.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5"
  }
}
