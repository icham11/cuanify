{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/generate-analytics",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/process-scheduled-shipments",
      "schedule": "*/5 * * * *"
    }
  ]
}
