prisma:query SELECT COUNT(*) AS "_count$_all" FROM (SELECT "public"."Product"."id" FROM "public"."Product" LEFT JOIN "public"."Category" AS "j0" ON ("j0"."id") = ("public"."Product"."categoryId") WHERE ("public"."Product"."businessId" = $1 AND "public"."Product"."deletedAt" IS NULL AND ("public"."Product"."categoryId" IS NULL OR ("j0"."name" NOT IN ($2,$3) AND ("j0"."id" IS NOT NULL)))) OFFSET $4) AS "sub"
prisma:query 
      SELECT
        AVG("sellingPrice")::text                                                     AS avg_price,
        AVG(
          CASE WHEN "sellingPrice" > 0 AND "cogs" > 0
               THEN GREATEST(-200, LEAST(100,
                    ("sellingPrice" - "cogs") / "sellingPrice" * 100))
               ELSE NULL
          END
        )::text                                                                       AS avg_margin
      FROM "Product"
      WHERE "businessId" = $1 AND "deletedAt" IS NULL AND (
        "categoryId" IS NULL OR "categoryId" NOT IN (
          SELECT id
          FROM "Category"
          WHERE "businessId" = $2
            AND name IN ($3,$4)
        )
      )
    
