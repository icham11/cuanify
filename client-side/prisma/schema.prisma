generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id           Int              @id @default(autoincrement())
  name         String
  email        String           @unique
  password     String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  businesses   Business[]
  memberships  BusinessMember[]
  closedShifts CashierShift[]   @relation("ShiftClosedBy")
  openedShifts CashierShift[]   @relation("ShiftOpenedBy")
}

model Business {
  id                   Int                    @id @default(autoincrement())
  name                 String
  userId               Int
  location             String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  analyticsInsights    AnalyticsInsight[]
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents            BusinessDocument[]
  businessForecasts    BusinessForecast[]
  businessHealthScores BusinessHealthScores[]
  members              BusinessMember[]
  businessMetrics      BusinessMetrics[]
  cashierShifts        CashierShift[]
  categories           Category[]
  chatMessages         ChatMessage[]
  chatSessions         ChatSession[]
  debts                Debt[]
  forecastAccuracy     ForecastAccuracy?
  ingredients          Ingredient[]
  products             Product[]
  productionBatches    ProductionBatch[]
  marketplaceSales     MarketplaceSale[]
  bakery_orders        bakery_orders[]
  production_capacity  production_capacity[]
  production_tasks     production_tasks[]
  sales                Sale[]
  stockDocuments       StockDocument[]

  @@index([userId, createdAt])
}

model BusinessMember {
  id         Int      @id @default(autoincrement())
  businessId Int
  userId     Int
  role       UserRole @default(Cashier)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId, role])
}

model CashierShift {
  id                    Int         @id @default(autoincrement())
  businessId            Int
  userId                Int
  closedByUserId        Int?
  status                ShiftStatus @default(Open)
  openingCash           Decimal     @db.Decimal(14, 2)
  expectedCash          Decimal?    @db.Decimal(14, 2)
  actualCash            Decimal?    @db.Decimal(14, 2)
  discrepancy           Decimal?    @db.Decimal(14, 2)
  cashSalesTotal        Decimal?    @db.Decimal(14, 2)
  qrisSalesTotal        Decimal?    @db.Decimal(14, 2)
  transferSalesTotal    Decimal?    @db.Decimal(14, 2)
  digitalSalesTotal     Decimal?    @db.Decimal(14, 2)
  kasbonTotal           Decimal?    @db.Decimal(14, 2)
  totalRevenue          Decimal?    @db.Decimal(14, 2)
  transactionCount      Int?
  notes                 String?
  openedAt              DateTime    @default(now())
  closedAt              DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  marketplaceSalesTotal Decimal?    @db.Decimal(14, 2)
  business              Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  closedBy              User?       @relation("ShiftClosedBy", fields: [closedByUserId], references: [id])
  openedBy              User        @relation("ShiftOpenedBy", fields: [userId], references: [id])
  sales                 Sale[]

  @@index([businessId, status])
  @@index([businessId, openedAt(sort: Desc)])
  @@index([userId])
}

model Debt {
  id            Int           @id @default(autoincrement())
  businessId    Int
  saleId        Int           @unique
  customerName  String
  customerPhone String?
  totalAmount   Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  status        DebtStatus    @default(Unpaid)
  notes         String?
  dueDate       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  payments      DebtPayment[]

  @@index([businessId, status])
  @@index([businessId, customerName])
  @@index([businessId, createdAt(sort: Desc)])
}

model DebtPayment {
  id        Int      @id @default(autoincrement())
  debtId    Int
  amount    Decimal  @db.Decimal(12, 2)
  notes     String?
  createdAt DateTime @default(now())
  debt      Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId, createdAt])
}

model BusinessDocument {
  id          Int                    @id @default(autoincrement())
  businessId  Int
  content     String
  embedding   Unsupported("vector")?
  sourceType  String
  sourceId    Int?
  metadata    Json?
  chunkIndex  Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  contentHash String?
  business    Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, sourceType])
  @@index([businessId])
  @@index([sourceType])
  @@index([businessId, contentHash])
}

model ChatSession {
  id         Int           @id @default(autoincrement())
  businessId Int
  title      String        @default("New Chat")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  messages   ChatMessage[]
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, updatedAt(sort: Desc)])
}

model ChatMessage {
  id          Int          @id @default(autoincrement())
  businessId  Int
  sessionId   Int?
  role        String
  content     String
  contextType String?
  metadata    Json?
  createdAt   DateTime     @default(now())
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  session     ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([businessId, sessionId, createdAt])
  @@index([sessionId, createdAt])
}

model Category {
  id         Int       @id @default(autoincrement())
  businessId Int
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products   Product[]

  @@index([businessId])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Product {
  id                Int               @id @default(autoincrement())
  businessId        Int
  categoryId        Int?
  name              String
  sellingPrice      Decimal           @db.Decimal(12, 2)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  recipeCost        Decimal           @default(0) @db.Decimal(12, 2)
  deletedAt         DateTime?
  productType       ProductType       @default(PreOrder)
  cogs              Decimal           @db.Decimal(15, 2)
  productionToken   Int               @default(0)
  manualStock       Int               @default(0)
  minimumOrder      Int               @default(0)
  business          Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category          Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  productForecasts  ProductForecast[]
  productMetrics    ProductMetrics[]
  productionBatches ProductionBatch[]
  recipes           Recipe[]
  saleItems         SaleItem[]

  @@index([businessId, isActive])
  @@index([businessId, deletedAt])
  @@index([businessId, categoryId])
  @@index([categoryId])
}

model ProductionBatch {
  id              Int            @id @default(autoincrement())
  productId       Int
  businessId      Int
  quantity        Int
  remainingQty    Int
  costPerUnit     Decimal        @db.Decimal(12, 2)
  stockDocumentId Int?
  producedAt      DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockDocument   StockDocument? @relation(fields: [stockDocumentId], references: [id])

  @@index([productId, remainingQty])
  @@index([businessId, producedAt(sort: Desc)])
}

model Ingredient {
  id                 Int                 @id @default(autoincrement())
  businessId         Int
  name               String
  unit               String
  minStock           Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventoryBatches   InventoryBatch[]
  inventoryMovements InventoryMovement[]
  recipes            Recipe[]

  @@index([businessId, createdAt(sort: Desc)])
}

model Recipe {
  id           Int        @id @default(autoincrement())
  productId    Int
  ingredientId Int
  quantity     Decimal    @db.Decimal(10, 3)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
  @@index([productId])
  @@index([ingredientId])
}

model StockDocument {
  id                 Int                 @id @default(autoincrement())
  businessId         Int
  type               StockDocumentType
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventoryMovements InventoryMovement[]
  productionBatches  ProductionBatch[]
  sales              Sale[]
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, type])
}

model InventoryMovement {
  id                     Int                   @id @default(autoincrement())
  ingredientId           Int?
  stockDocumentId        Int
  quantity               Decimal               @db.Decimal(10, 3)
  costPerUnit            Decimal               @db.Decimal(12, 2)
  type                   InventoryMovementType
  createdAt              DateTime              @default(now())
  /// Preserved when the ingredient is later deleted
  ingredientNameSnapshot String?
  ingredientUnitSnapshot String?
  ingredient             Ingredient?           @relation(fields: [ingredientId], references: [id])
  stockDocument          StockDocument         @relation(fields: [stockDocumentId], references: [id], onDelete: Cascade)

  @@index([ingredientId, type])
  @@index([stockDocumentId])
  @@index([ingredientId, createdAt])
}

model InventoryBatch {
  id             Int        @id @default(autoincrement())
  ingredientId   Int
  remainingQty   Decimal    @db.Decimal(10, 3)
  costPerUnit    Decimal    @db.Decimal(12, 2)
  receivedAt     DateTime   @default(now())
  expirationDate DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId, receivedAt])
  @@index([ingredientId, remainingQty])
}

model Sale {
  id                Int            @id @default(autoincrement())
  businessId        Int
  stockDocumentId   Int?
  transactionNumber String         @unique
  totalRevenue      Decimal        @db.Decimal(12, 2)
  totalCost         Decimal        @db.Decimal(12, 2)
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus  @default(Pending)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  customerName      String?
  customerEmail     String?
  customerPhone     String?
  invoiceId         String?
  invoiceUrl        String?
  invoiceStatus     String?
  sales_channel     SalesChannel   @default(direct)
  cashierShiftId    Int?
  debt              Debt?
  business          Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cashierShift      CashierShift?  @relation(fields: [cashierShiftId], references: [id])
  stockDocument     StockDocument? @relation(fields: [stockDocumentId], references: [id])
  saleItems         SaleItem[]

  @@index([businessId, createdAt(sort: Desc)])
  @@index([businessId, paymentStatus])
  @@index([businessId, paymentMethod])
  @@index([businessId, sales_channel])
  @@index([cashierShiftId])
}

model SaleItem {
  id          Int      @id @default(autoincrement())
  saleId      Int
  productId   Int
  quantity    Int
  priceAtSale Decimal  @db.Decimal(12, 2)
  costAtSale  Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
}

model BusinessMetrics {
  id           Int      @id @default(autoincrement())
  businessId   Int
  date         DateTime @db.Date
  totalRevenue Decimal  @db.Decimal(14, 2)
  totalCost    Decimal  @db.Decimal(14, 2)
  totalProfit  Decimal  @db.Decimal(14, 2)
  marginAvg    Float
  growthRate   Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
  @@index([businessId, date(sort: Desc)])
}

model ProductMetrics {
  id           Int      @id @default(autoincrement())
  productId    Int
  date         DateTime @db.Date
  quantitySold Int
  revenue      Decimal  @db.Decimal(14, 2)
  cost         Decimal  @db.Decimal(14, 2)
  profit       Decimal  @db.Decimal(14, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([productId, date(sort: Desc)])
}

model ProductForecast {
  id                    Int      @id @default(autoincrement())
  productId             Int
  date                  DateTime @db.Date
  predictedQty          Int
  recommendedProduction String?
  confidenceScore       Decimal  @db.Decimal(5, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  lowerBound            Int      @default(0)
  upperBound            Int      @default(0)
  metadata              Json?
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([productId, date(sort: Desc)])
}

model BusinessForecast {
  id               Int      @id @default(autoincrement())
  businessId       Int
  date             DateTime @db.Date
  predictedRevenue Decimal  @db.Decimal(14, 2)
  lowerBound       Decimal  @db.Decimal(14, 2)
  upperBound       Decimal  @db.Decimal(14, 2)
  confidenceScore  Decimal  @db.Decimal(5, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  predictedProfit  Decimal  @default(0) @db.Decimal(14, 2)
  metadata         Json?
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
  @@index([businessId, date(sort: Desc)])
}

model ForecastAccuracy {
  id              Int      @id @default(autoincrement())
  businessId      Int      @unique
  accuracy7d      Decimal? @db.Decimal(5, 2)
  accuracy30d     Decimal? @db.Decimal(5, 2)
  mape7d          Decimal? @db.Decimal(5, 2)
  mape30d         Decimal? @db.Decimal(5, 2)
  sampleSize7d    Int      @default(0)
  sampleSize30d   Int      @default(0)
  lastEvaluatedAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model AnalyticsInsight {
  id          Int      @id @default(autoincrement())
  businessId  Int
  section     String
  insight     String
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, section])
  @@index([businessId])
}

model BusinessHealthScores {
  id             Int      @id @default(autoincrement())
  businessId     Int
  date           DateTime @db.Date
  revenueScore   Float
  profitScore    Float
  wasteScore     Float
  stabilityScore Float
  overallScore   Float
  classification String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
  @@index([businessId, date(sort: Desc)])
}

model WebhookEvent {
  id           Int       @id @default(autoincrement())
  eventId      String    @unique
  source       String
  status       String    @default("processing")
  payload      Json?
  processedAt  DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([source])
  @@index([createdAt])
  @@index([status, createdAt])
}

// ==================== MARKETPLACE SALES (Tokped/Shopee) ====================

model MarketplaceSale {
  id          Int      @id @default(autoincrement())
  businessId  Int
  marketplace String // "Tokopedia" | "Shopee"
  orderId     String? // ID Pesanan dari marketplace
  totalAmount Decimal  @db.Decimal(14, 2)
  itemName    String? // Nama barang (opsional)
  saleDate    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([saleDate])
}

model bakery_order_addresses {
  id                BigInt   @id @default(autoincrement())
  business_id       Int
  order_external_id String
  address_index     Int
  payload           Json
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  @@index([business_id, order_external_id, address_index], map: "idx_bakery_order_addresses_lookup")
}

model bakery_order_items {
  id                BigInt   @id @default(autoincrement())
  business_id       Int
  order_external_id String
  item_index        Int
  payload           Json
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  @@index([business_id, order_external_id, item_index], map: "idx_bakery_order_items_lookup")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bakery_orders {
  id                     BigInt    @id @default(autoincrement())
  business_id            Int
  external_id            String
  booking_code           String?
  resi                   String?
  customer_name          String?
  customer_phone         String?
  customer_address       String?
  delivery_date          String?
  delivery_slot          String?
  notes                  String?
  base_price             Decimal   @default(0) @db.Decimal(14, 2)
  design_adjustment_total Decimal  @default(0) @db.Decimal(14, 2)
  add_on_total           Decimal   @default(0) @db.Decimal(14, 2)
  product_adjustment     Decimal   @default(0) @db.Decimal(14, 2)
  non_product_adjustment Decimal   @default(0) @db.Decimal(14, 2)
  product_subtotal       Decimal   @default(0) @db.Decimal(14, 2)
  product_discount_amount Decimal  @default(0) @db.Decimal(14, 2)
  service_charge         Decimal   @default(0) @db.Decimal(14, 2)
  delivery_fee           Decimal   @default(0) @db.Decimal(14, 2)
  manual_adjustment      Decimal   @default(0) @db.Decimal(14, 2)
  dp_paid_amount         Decimal   @default(0) @db.Decimal(14, 2)
  final_paid_amount      Decimal   @default(0) @db.Decimal(14, 2)
  total_paid_amount      Decimal   @default(0) @db.Decimal(14, 2)
  down_payment_amount    Decimal   @default(0) @db.Decimal(14, 2)
  remaining_balance      Decimal   @default(0) @db.Decimal(14, 2)
  product                String?
  total_price            Decimal   @default(0) @db.Decimal(14, 2)
  payment_status         String?
  order_status           String?
  shipping_quote         Json?
  shipment               Json?
  simulations            Json?
  whatsapp_parsed_data   Json?
  status_history         Json?
  automation_logs        Json?
  payment_transactions   Json?
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @db.Timestamptz(6)
  difficulty             String?
  token_used             Int       @default(0)
  assigned_staff_user_id Int?
  assigned_staff_name    String?
  production_assigned_at DateTime? @db.Timestamptz(6)
  deleted_at             DateTime? @db.Timestamptz(6)
  insurance_fee          Decimal   @default(0) @db.Decimal(14, 2)
  sales_channel          String    @default("direct")
  order_uuid             String?   @db.Uuid
  business               Business? @relation(fields: [businessId], references: [id])
  businessId             Int?

  @@unique([business_id, external_id])
  @@index([business_id, updated_at(sort: Desc)], map: "idx_bakery_orders_business_updated")
}

model bakery_staff_monthly_token_resets {
  id                 BigInt   @id @default(autoincrement())
  business_id        Int
  staff_user_id      Int
  month_key          String
  baseline_token     Int      @default(0)
  reset_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_by_user_id Int
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)

  @@unique([business_id, staff_user_id, month_key], map: "bakery_staff_monthly_token_re_business_id_staff_user_id_mon_key")
  @@index([business_id, month_key, staff_user_id], map: "idx_bakery_staff_monthly_token_resets_lookup")
}

model production_capacity {
  id          BigInt    @id @default(autoincrement())
  business_id Int
  date        DateTime  @db.Date
  max_token   Int       @default(600)
  used_token  Int       @default(0)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  business    Business? @relation(fields: [businessId], references: [id])
  businessId  Int?

  @@unique([business_id, date])
  @@index([business_id, date], map: "idx_production_capacity_biz_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model production_tasks {
  id           String    @id @db.Uuid
  order_id     String    @db.Uuid
  stage        String
  staff_id     String?   @db.Uuid
  token_amount Decimal   @db.Decimal(10, 2)
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  business     Business? @relation(fields: [businessId], references: [id])
  businessId   Int?

  @@unique([order_id, stage], map: "production_tasks_order_stage_unique")
  @@index([order_id], map: "idx_production_tasks_order_id")
}

enum PaymentMethod {
  Digital
  QRIS
  Transfer
  Cash
  Kasbon
  Marketplace
}

enum PaymentStatus {
  Pending
  Paid
}

enum SalesChannel {
  direct
  tokopedia
  shopee
}

enum StockDocumentType {
  Purchase
  Sale
  Waste
  Production
}

enum InventoryMovementType {
  In
  Out
}

enum ProductType {
  ReadyStock
  PreOrder
}

enum UserRole {
  Owner
  Cashier
  Staff
  Admin
}

enum DebtStatus {
  Unpaid
  Partial
  Paid
}

enum ShiftStatus {
  Open
  Closed
}
